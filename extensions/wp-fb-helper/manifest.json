{
  "manifest_version": 3,
  "name": "WP FB Helper",
  "version": "1.1.26",
  "description": "Pick WordPress posts on Facebook, copy titles, save the Facebook permalink back to the post.",
  "permissions": [
    "storage",
    "tabs",
    "clipboardWrite",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "WP FB Helper",
    "default_popup": "options/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options/popup.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://facebook.com/*",
        "https://web.facebook.com/*",
        "https://business.facebook.com/*",
        "https://m.facebook.com/*"
      ],
      "js": ["content/fb-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://facebook.com/*",
        "https://web.facebook.com/*",
        "https://business.facebook.com/*",
        "https://m.facebook.com/*"
      ],
      "js": ["content/panel-shell.js", "content/panel.js"],
      "css": ["content/panel.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
